# One-time setup key: typed once on the first sign-in screen to create the first admin login.
APP_PASSWORD=
# Postgres connection string (Supabase Session pooler, port 5432). Leave empty locally to use the embedded database in .data/.
DATABASE_URL=
# Secret Vercel Cron sends to /api/cron/backup.
CRON_SECRET=
# Signs login cookies (32+ random characters, e.g. `openssl rand -base64 48`). Required in production; changing it signs everyone out.
SESSION_SECRET=
